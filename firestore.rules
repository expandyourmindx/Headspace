rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{uid} {
      // Helper: Verify owner of this user record path
      function isOwner(uid) {
        return request.auth != null && request.auth.uid == uid;
      }

      // Helper: Defend string document IDs from being resource exploits
      function isValidId(id) {
        return id is string && id.size() <= 128 && id.matches('^[0-9]+$');
      }

      // Helper: Return incoming data
      function incoming() {
        return request.resource.data;
      }

      // Space schema definition validation helper
      function isValidSpace(data) {
        return data.name is string && data.name.size() > 0 && data.name.size() <= 128
            && data.icon is string && data.icon.size() > 0 && data.icon.size() <= 64
            && data.color is string && data.color.size() > 0 && data.color.size() <= 16
            && (data.themeId == null || (data.themeId is string && data.themeId.size() <= 64))
            && (data.pinned == null || data.pinned is bool)
            && data.createdAt is int
            && data.updatedAt is int;
      }

      // Page schema definition validation helper
      function isValidPage(data) {
        return data.spaceId is int
            && data.name is string && data.name.size() > 0 && data.name.size() <= 128
            && data.order is int
            && data.icon is string && data.icon.size() > 0 && data.icon.size() <= 64
            && data.createdAt is int
            && data.updatedAt is int;
      }

      // Task (entries) schema definition validation helper
      function isValidTask(data) {
        return data.spaceId is int
            && data.pageId is int
            && data.title is string && data.title.size() > 0 && data.title.size() <= 256
            && data.description is string && data.description.size() <= 4096
            && data.status is string && (data.status == 'todo' || data.status == 'in-progress' || data.status == 'done')
            && data.priority is string && (data.priority == 'low' || data.priority == 'medium' || data.priority == 'high')
            && data.order is int
            && (data.dueDate == null || data.dueDate is int)
            && data.createdAt is int
            && data.updatedAt is int;
      }

      match /spaces/{spaceId} {
        allow read: if isOwner(uid) && isValidId(spaceId);
        allow create: if isOwner(uid) && isValidId(spaceId) && isValidSpace(incoming());
        allow update: if isOwner(uid) && isValidId(spaceId) && isValidSpace(incoming());
        allow delete: if isOwner(uid) && isValidId(spaceId);
      }

      match /pages/{pageId} {
        allow read: if isOwner(uid) && isValidId(pageId);
        allow create: if isOwner(uid) && isValidId(pageId) && isValidPage(incoming());
        allow update: if isOwner(uid) && isValidId(pageId) && isValidPage(incoming());
        allow delete: if isOwner(uid) && isValidId(pageId);
      }

      match /entries/{entryId} {
        allow read: if isOwner(uid) && isValidId(entryId);
        allow create: if isOwner(uid) && isValidId(entryId) && isValidTask(incoming());
        allow update: if isOwner(uid) && isValidId(entryId) && isValidTask(incoming());
        allow delete: if isOwner(uid) && isValidId(entryId);
      }
    }
  }
}
